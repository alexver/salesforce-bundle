{
  "name": "genesis-global/salesforce-bundle",
  "description": "Symfony bundle that provides OAuth2 authentication and exposes Salesforce REST API methods in OOP friendly way. ",
  "type": "symfony-bundle",
  "keywords": [ "salesforce"],
  "license": "MIT",
  "require": {
    "symfony/http-kernel": "^6.0 || ^7.0 || ^8.0",
    "symfony/config": "^6.0 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.0 || ^7.0 || ^8.0",
    "genesis-global/salesforce": "dev-master-symfony_7_8 as 1.1.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "GenesisGlobal\\Salesforce\\SalesforceBundle\\": "src/"
    }
  }
}